{% extends 'base.html.twig' %}

{% block title %}Coaches{% endblock %}

{% block body %}
<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h1 class="display-6 fw-bold mb-0"><i class="fas fa-chalkboard-user me-3"></i>Coaches</h1>
        <p class="mb-0 opacity-75">Manage all gym coaches</p>
    </div>
    <a href="{{ path('app_coach_new') }}" class="btn btn-light btn-lg rounded-pill shadow-sm">
        <i class="fas fa-plus me-2"></i>Add Coach
    </a>
</div>

<div class="row">
    {% for coach in coaches %}
    <div class="col-md-6 col-lg-4 mb-4">
        <div class="card h-100 border-0 shadow-sm rounded-4">
            <div class="card-body">
                <div class="d-flex align-items-center mb-3">
                    <div class="bg-primary bg-gradient text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                        <i class="fas fa-user-tie fa-lg"></i>
                    </div>
                    <div class="ms-3">
                        <h5 class="mb-0 fw-bold">{{ coach.name }} {{ coach.surname }}</h5>
                        <span class="badge bg-info mt-1">{{ coach.specialty }}</span>
                    </div>
                </div>
                <hr>
                <div class="d-flex justify-content-end gap-2">
                    <a href="{{ path('app_coach_show', {'id': coach.id}) }}" class="btn btn-sm btn-outline-info">
                        <i class="fas fa-eye"></i> Show
                    </a>
                    <a href="{{ path('app_coach_edit', {'id': coach.id}) }}" class="btn btn-sm btn-outline-warning">
                        <i class="fas fa-edit"></i> Edit
                    </a>
                </div>
            </div>
        </div>
    </div>
    {% else %}
    <div class="col-12 text-center py-5">
        <i class="fas fa-chalkboard-user fa-4x text-muted mb-3 d-block"></i>
        <p class="text-muted">No coaches found</p>
        <a href="{{ path('app_coach_new') }}" class="btn btn-primary">Add your first coach</a>
    </div>
    {% endfor %}
</div>
{% endblock %}