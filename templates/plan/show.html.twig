{% extends 'base.html.twig' %}

{% block title %}Plan Details{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-header bg-white border-0 pt-4">
                    <h1 class="h3 mb-0 text-primary">
                        <i class="fas fa-clipboard-list me-2"></i>Plan Details
                    </h1>
                </div>
                <div class="card-body">
                    <div class="mb-4 pb-2 border-bottom">
                        <h4 class="fw-bold">{{ plan.name }}</h4>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-4 fw-semibold">Price:</div>
                        <div class="col-md-8"><span class="badge bg-success fs-6">{{ plan.price }} €</span></div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-4 fw-semibold">Duration:</div>
                        <div class="col-md-8">{{ plan.durationDays }} days</div>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-4 fw-semibold">Description:</div>
                        <div class="col-md-8">{{ plan.description|default('No description provided') }}</div>
                    </div>

                    <div class="d-flex gap-3 mt-4">
                        <a href="{{ path('app_plan_edit', {'id': plan.id}) }}" class="btn btn-warning">
                            <i class="fas fa-edit me-2"></i>Edit
                        </a>
                        <a href="{{ path('app_plan_index') }}" class="btn btn-outline-secondary">
                            <i class="fas fa-arrow-left me-2"></i>Back to list
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}