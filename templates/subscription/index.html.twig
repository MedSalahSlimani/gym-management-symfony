{% extends 'base.html.twig' %}

{% block title %}Subscriptions{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Subscriptions</h1>
    <a href="{{ path('app_subscription_new') }}" class="btn btn-primary"><i class="fas fa-plus"></i> New</a>
</div>
<div class="card"><div class="card-body">
    <table class="table table-striped">
        <thead><tr><th>Member</th><th>Plan</th><th>Start</th><th>End</th><th>Paid</th><th>Actions</th></tr></thead>
        <tbody>
            {% for sub in subscriptions %}
            <tr>
                <td>{{ sub.member.name ~ ' ' ~ sub.member.surname }}</td>
                <td>{{ sub.plan.name }}</td>
                <td>{{ sub.startDate|date('Y-m-d') }}</td>
                <td>{{ sub.endDate|date('Y-m-d') }}</td>
                <td>{% if sub.isPaid %}<span class="badge bg-success">Yes</span>{% else %}<span class="badge bg-warning">No</span>{% endif %}</td>
                <td><a href="{{ path('app_subscription_show', {'id': sub.id}) }}" class="btn btn-sm btn-info">Show</a>
                    <a href="{{ path('app_subscription_edit', {'id': sub.id}) }}" class="btn btn-sm btn-warning">Edit</a></td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div></div>
{% endblock %}