{% extends 'base.html.twig' %}

{% block title %}Reset Password{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-md-4">
        <div class="card shadow">
            <div class="card-header bg-success text-white text-center"><h4><i class="fas fa-lock"></i> New Password</h4></div>
            <div class="card-body">
                {{ form_start(form) }}
                {{ form_widget(form) }}
                <button type="submit" class="btn btn-success w-100 mt-3">Update password</button>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}