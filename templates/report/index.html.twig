{% extends 'base.html.twig' %}

{% block title %}Most Popular Sessions{% endblock %}

{% block body %}
<div class="card">
    <div class="card-header bg-primary text-white">
        <h3 class="mb-0"><i class="fas fa-chart-line"></i> Most Popular Sessions</h3>
    </div>
    <div class="card-body">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Session Title</th>
                    <th>Number of Bookings</th>
                </tr>
            </thead>
            <tbody>
                {% for session in sessions %}
                    <tr>
                        <td>{{ session.title }}</td>
                        <td>
                            <span class="badge bg-success">{{ session.howMany }}</span>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="2" class="text-center">No data available</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}