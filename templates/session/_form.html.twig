{{ form_start(form, {'attr': {'class': 'needs-validation'}}) }}

<div class="mb-3">
    {{ form_label(form.title, 'Title', {'label_attr': {'class': 'form-label fw-semibold'}}) }}
    {{ form_widget(form.title, {'attr': {'class': 'form-control rounded-3', 'placeholder': 'e.g., Boxing Advanced'}}) }}
</div>

<div class="row">
    <div class="col-md-6 mb-3">
        {{ form_label(form.sessionDate, 'Session date', {'label_attr': {'class': 'form-label fw-semibold'}}) }}
        {{ form_widget(form.sessionDate, {'attr': {'class': 'form-control rounded-3'}}) }}
    </div>
    <div class="col-md-6 mb-3">
        {{ form_label(form.duration, 'Duration (minutes)', {'label_attr': {'class': 'form-label fw-semibold'}}) }}
        {{ form_widget(form.duration, {'attr': {'class': 'form-control rounded-3', 'placeholder': 'e.g., 60'}}) }}
    </div>
</div>

<div class="mb-4">
    {{ form_label(form.capacity, 'Capacity', {'label_attr': {'class': 'form-label fw-semibold'}}) }}
    {{ form_widget(form.capacity, {'attr': {'class': 'form-control rounded-3', 'placeholder': 'e.g., 20'}}) }}
</div>

<!-- Coaches -->
<div class="mb-4">
    <label class="form-label fw-semibold">Coaches</label>
    <div class="border rounded-3 p-3 bg-light">
        {% for coach in form.coaches %}
            <div class="form-check mb-2">
                {{ form_widget(coach, {'attr': {'class': 'form-check-input'}}) }}
                {{ form_label(coach, null, {'label_attr': {'class': 'form-check-label'}}) }}
            </div>
        {% else %}
            <p class="text-muted mb-0 small">No coaches available</p>
        {% endfor %}
    </div>
</div>

<!-- Members -->
<div class="mb-4">
    <label class="form-label fw-semibold">Members</label>
    <div class="border rounded-3 p-3 bg-light">
        {% for member in form.members %}
            <div class="form-check mb-2">
                {{ form_widget(member, {'attr': {'class': 'form-check-input'}}) }}
                {{ form_label(member, null, {'label_attr': {'class': 'form-check-label'}}) }}
            </div>
        {% else %}
            <p class="text-muted mb-0 small">No members available</p>
        {% endfor %}
    </div>
</div>

<div class="d-flex gap-3 mt-4">
    <button type="submit" class="btn btn-primary px-4 py-2 rounded-pill">
        <i class="fas fa-save me-2"></i>Save
    </button>
    <a href="{{ path('app_session_index') }}" class="btn btn-outline-secondary px-4 py-2 rounded-pill">
        <i class="fas fa-arrow-left me-2"></i>back to list
    </a>
</div>

{{ form_end(form) }}